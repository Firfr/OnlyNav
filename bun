#!/bin/bash

echo "启动 Bun 容器，在容器中开发前端"

docker run --rm -it --name Bun \
  --user 1000:1000 --hostname Bun \
  --network host --cpus=2  --memory=2G \
  -e BUN_INSTALL_REGISTRY=http://npm.firfe.de5.net \
  -e LANG=zh_CN.UTF-8 -e LOG_LEVEL=trace \
  -e DATA_PATH=/app/数据 -w /app -v ./:/app \
  docker.code.firfe.work/oven/bun:1.3.11 \
  sh -c 'printf "cd server\ncd web\nbun dev\n" >> ~/.bash_history && exec bash'
